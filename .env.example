# ==============================================================================
# VARIÁVEIS DE AMBIENTE - PORTAL DE ESCALAS E PERMUTAS CBMERJ
# ==============================================================================

# GEMINI_API_KEY: Necessário para recursos de IA (injetado automaticamente pelo AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SYNC_API_KEY: Senha para sincronizacao do DGP
SYNC_API_KEY="MINHA_SENHA_SEGURA"

# APP_URL: Endereço web público da aplicação (ex: https://conexaobravo.onrender.com).
# Utilizado para montar os links diretos de recuperação de senha enviados por e-mail.
APP_URL="https://meu-app.onrender.com"

# ==============================================================================
# CONFIGURAÇÃO DE E-MAIL (SMTP) - RECUPERAÇÃO DE SENHA
# ==============================================================================
# O sistema pode enviar os códigos e links de recuperação de senha diretamente
# para o e-mail cadastrado de cada militar.
#
# DICA: Você também pode preencher e testar estes dados diretamente pelo painel
# no menu "Configurações > Envio de E-mails (SMTP)" sem precisar reiniciar o servidor!

# 1. SMTP_HOST: Endereço do servidor SMTP do seu provedor de e-mail.
#    - Para Gmail: "smtp.gmail.com"
#    - Para Outlook / Hotmail: "smtp.office365.com"
#    - Para servidor próprio: "mail.seudominio.com.br"
SMTP_HOST="smtp.gmail.com"

# 2. SMTP_PORT: Porta de comunicação com o servidor de e-mail.
#    - Porta 587 (Padrão para TLS / STARTTLS - Recomendado)
#    - Porta 465 (Para conexão direta SSL)
SMTP_PORT=587

# 3. SMTP_SECURE: Define se a conexão usa SSL direto na inicialização.
#    - Use "false" para a porta 587 (pois ela inicia texto e eleva com STARTTLS).
#    - Use "true" se você estiver utilizando a porta 465 (SSL).
SMTP_SECURE="false"

# 4. SMTP_USER: O endereço de e-mail completo que realizará os envios.
#    Exemplo: "seu-email@gmail.com" ou "escalas.cbmerj@gmail.com"
SMTP_USER="seu-email@gmail.com"

# 5. SMTP_PASS: Senha de autenticação do e-mail.
#    ⚠️ ATENÇÃO CRUCIAL PARA GMAIL:
#    Não use a sua senha pessoal habitual do Google! O Google bloqueia envios externos.
#    Você deve gerar uma "Senha de Aplicativo" de 16 letras na Conta Google:
#    1. Acesse: https://myaccount.google.com/security
#    2. Ative a "Verificação em duas etapas" (se ainda não estiver ativada).
#    3. Pesquise por "Senhas de app" (https://myaccount.google.com/apppasswords).
#    4. Crie uma senha com o nome "Portal CBMERJ".
#    5. Cole as 16 letras aqui (sem espaços). Exemplo: "abcdefghijklmnop"
SMTP_PASS="sua-senha-de-app-16-letras"

# 6. SMTP_FROM: Nome de exibição e e-mail que o militar verá na caixa postal.
#    O e-mail dentro das chaves <...> deve ser o mesmo cadastrado em SMTP_USER.
#    Exemplo: '"Portal CBMERJ" <seu-email@gmail.com>'
SMTP_FROM='"Portal CBMERJ" <seu-email@gmail.com>'
