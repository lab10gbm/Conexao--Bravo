rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'MrBlous@gmail.com' ||
        request.auth.token.email == 'system_admin@cbmerj.com' ||
        request.auth.token.email == '54444@cbmerj.com' ||
        request.auth.token.email == '54444@cbmrj.br' ||
        request.auth.token.email == '54208@cbmerj.com' ||
        request.auth.token.email == '54208@cbmrj.br'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isAdminEmail() ||
        request.auth.token.admin == true ||
        request.auth.uid == '54444' ||
        request.auth.uid == '54208'
      );
    }

    function isEscalante() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.escalante == true
      );
    }

    function isOwner(rg) {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == rg ||
        request.auth.token.rg == rg ||
        request.auth.token.email == rg + '@cbmerj.com' ||
        request.auth.token.email == rg + '@cbmrj.br'
      );
    }

    // Militares (Perfis)
    match /militaries/{rg} {
      allow read, write: if isAuthenticated();

      match /private/{document=**} {
        allow read, write: if isOwner(rg) || isAdmin();
      }
    }

    // Presença e Status Online
    match /presence/{rg} {
      allow read, write: if isAuthenticated();
    }

    // Medidas Antropométricas e EPIs
    match /medidasAntropometricas/{rg} {
      allow read, write: if isAuthenticated();
    }

    // Permutas (Rede Social de Trocas e Assinaturas Mútuas)
    match /permutas/{permutaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        isEscalante() ||
        isAdmin() ||
        resource.data.requesterRg == request.auth.uid ||
        request.auth.token.email == resource.data.requesterRg + '@cbmerj.com'
      );
    }

    // RAS (Regime Adicional de Serviço)
    match /ras_opportunities/{oppId} {
      allow read, write: if isAuthenticated();
    }

    match /ras_applications/{appId} {
      allow read, write: if isAuthenticated();
    }

    // Férias e Afastamentos
    match /vacations/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /vacation_preferences/{prefId} {
      allow read, write: if isAuthenticated();
    }

    match /vacation_validations/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /afastamentos_alas/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Usuários Terceirizados / Civis
    match /outsourced_users/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Carga Pública e Patrimônio
    match /patrimonioData/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /patrimonioConfig/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /customSectors/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Refeitório e Cardápio
    match /refeitorio/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Guarnições ativas
    match /guarnicoes/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Mural de Avisos
    match /mural_avisos/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Viaturas e Alertas
    match /viatura_alerts/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Livro de Escalas e Registro
    match /registro_escalas_24h/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Configurações Globais (públicas para leitura imediata)
    match /config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Configurações do Sistema
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Configurações e Postos por OBM
    match /obm_settings/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Escalas de Oficiais e Médicos
    match /officer_pool_config/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /officer_scales/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /nautico_scales/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /medico_scales/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /grd_configs/{docId} {
      allow read, write: if isAuthenticated();
    }

    // SOP e Efetivo
    match /sop_roster/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /personalData/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Aprovisionamento (Estoque e Compras)
    match /aprovisionamento/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Translado (Veículos e Viagens)
    match /translado_vehicles/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /translado_trips/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Tarefas / Agenda Pessoal do Militar
    match /users/{rg}/todos/{todoId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback para coleções dinâmicas de escala (escala24h_*, expediente_*) e documentos gerais
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
